# Project-Lewis — variáveis de ambiente de desenvolvimento
#
# Copie este arquivo para `.env` e ajuste conforme necessário.
# Nunca commite valores secretos.

# ---------------------------------------------------------------------------
# Keras / TensorFlow
# ---------------------------------------------------------------------------
# O projeto utiliza Keras 3 standalone (pacote `keras`) para salvar e carregar
# modelos `.keras`. A importação de bibliotecas como `sentence-transformers`
# ou `tensorflow-model-optimization` pode redirecionar `tf.keras` para o
# pacote legado `tf_keras`, causando falhas de desserialização.
# Definir TF_USE_LEGACY_KERAS=0 antes de importar TensorFlow previne essa
# contaminação.
TF_USE_LEGACY_KERAS=0

# Backend do Keras quando usar Keras 3 standalone diretamente.
# O projeto opera apenas em CPU; mantenha `tensorflow` para compatibilidade
# com TFLite e tfmot.
KERAS_BACKEND=tensorflow

# ---------------------------------------------------------------------------
# Hardware / CUDA
# ---------------------------------------------------------------------------
# Descomente e ajuste se houver GPU disponível.
# CUDA_VISIBLE_DEVICES=0

# Suprime warnings informativos do TensorFlow (opcional).
TF_CPP_MIN_LOG_LEVEL=1
TF_ENABLE_ONEDNN_OPTS=0

# ---------------------------------------------------------------------------
# Caminhos de dados e modelos (exemplos)
# ---------------------------------------------------------------------------
# LEWIS_DATA_DIR=./data
# LEWIS_MODELS_DIR=./models
